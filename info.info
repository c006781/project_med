project_med/
├── app/                      # бэкенд
│   ├── config/               # конфигурация (env, msgpack)
│   ├── database/              # модели SQLAlchemy и класс Database
│   ├── dto/                   # Data Transfer Objects
│   ├── exceptions/            # кастомные исключения
│   ├── network/               # синхронизация с Яндекс.Диском (YaDisk, потоки)
│   ├── repositories/          # репозитории (слой доступа к данным)
│   ├── services/              # бизнес-логика (сервисы)
│   ├── utils/                 # утилиты (логгер, фильтрация)
│   └── dependencies.py        # фабрики для получения сервисов
├── interfaces/
│   ├── cli/                    # консольный интерфейс (click)
│   └── gui/                    # графический интерфейс (PySide6)
│       └── gui_window/         # собственно окно и компоненты
│           ├── controllers/     # менеджер страниц
│           ├── pages/           # страницы приложения
│           └── widgets/         # переиспользуемые виджеты (таблица с фильтром, делегат)
├── tests/                      # тесты (pytest)
│   ├── test_config/            # тесты конфигурации
│   ├── test_database_shema/    # тесты моделей и БД
│   ├── test_interfaces/        # тесты CLI
│   ├── test_logger/            # тесты логгера
│   ├── test_network/           # тесты сетевых функций
│   ├── test_repositories/      # тесты репозиториев
│   ├── test_services/          # тесты сервисов
│   └── conftest.py             # общие фикстуры
└── ... (requirements.txt, .env, и т.д.)